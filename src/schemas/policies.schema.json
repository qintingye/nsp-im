{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "NSP-IM Policies Schema",
  "version": "1.0",
  "type": "object",
  "required": ["version", "generated_at", "policies"],
  "properties": {
    "version": { "type": "string" },
    "generated_at": { "type": "string", "format": "date-time" },
    "source": { "type": "string" },
    "policies": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "title", "department", "publish_date"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^P-[A-Z]+-[0-9]{8}-[0-9]{4}$",
            "description": "政策 ID 格式 P-<源>-YYYYMMDD-<4位序号>，与 src/fetchers/ndrc.py L46 fetcher 输出对齐（fetcher 用 date.replace('-','') 生成 8 位日期段，hash(...)%10000:04d 生成 4 位序号）"
          },
          "title": { "type": "string" },
          "department": { "type": "string" },
          "doc_number": { "type": ["string", "null"] },
          "publish_date": { "type": "string", "format": "date" },
          "effective_date": { "type": "string", "format": "date" },
          "category": { "enum": ["policy", "price", "monitor", "standard"] },
          "scope": { "type": "array", "items": { "type": "string" } },
          "priority": { "type": "integer", "minimum": 1, "maximum": 5 },
          "summary": { "type": "string", "maxLength": 200 },
          "key_points": { "type": "array" },
          "source_url": { "type": "string", "format": "uri" },
          "captured_at": { "type": "string", "format": "date-time" },
          "captured_by": { "type": "string" },
          "tags": { "type": "array" },
          "review_status": { "enum": ["pending", "approved", "rejected"] }
        }
      }
    }
  }
}
